{
  "name": "@awesomeui/tokens",
  "version": "0.1.0",
  "description": "Design tokens for AwesomeUI — colors, spacing, typography, shadows",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./css": "./dist/css/variables.css"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@awesomeui/typescript-config": "*",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
