{
  "name": "awesomeui-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "AwesomeUI — Universal UI platform for every framework",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/transpilers/*",
    "tooling/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace=apps/web",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "clean": "npm run clean --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.1.1",
    "tsup": "^8.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
