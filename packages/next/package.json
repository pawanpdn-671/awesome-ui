{
  "name": "@awesomeui/next",
  "version": "0.1.0",
  "description": "Next.js adapter for AwesomeUI — RSC, SSR, App Router support",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@awesomeui/react": "*"
  },
  "peerDependencies": {
    "next": "^14.0.0 || ^15.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@awesomeui/typescript-config": "*",
    "@types/react": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "next": "^15.0.0",
    "react": "^19.0.0"
  }
}
