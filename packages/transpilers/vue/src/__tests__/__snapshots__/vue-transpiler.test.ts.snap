  },
  spinner: 'h-4 w-4 animate-spin',
} as const;
</script>

<template>
  <button :class="\`\${styles.base} \${styles.variant[props.variant]} \${styles.size[props.size]}\`.trim()" type="button" :disabled="props.disabled">
