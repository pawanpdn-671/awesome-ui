{
  "name": "@awesomeui/cli",
  "version": "0.1.0",
  "description": "CLI for the AwesomeUI cross-framework component platform",
  "type": "module",
  "bin": {
    "awesomeui": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@awesomeui/core": "*",
    "@awesomeui/transpiler-shared": "*",
    "@awesomeui/transpiler-react": "*",
    "@awesomeui/transpiler-vue": "*",
    "commander": "^13.1.0",
    "chalk": "^5.4.1",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.1.1",
    "tsup": "^8.4.0"
  }
}
