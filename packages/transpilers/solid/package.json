{
  "name": "@awesomeui/transpiler-solid",
  "version": "0.1.0",
  "description": "SolidJS transpiler for AwesomeUI IR",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@awesomeui/core": "*",
    "@awesomeui/transpiler-shared": "*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.1.1",
    "tsup": "^8.4.0"
  }
}
